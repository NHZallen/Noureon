{
  "manifest_version": 3,
  "name": "Noureon tab order",
  "description": "Tells the browser host in which order the tabs stand in the tab strip. Nothing else: no page access, no messages from pages.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js" }
}
