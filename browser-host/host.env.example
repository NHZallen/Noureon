# Settings of one browser host. install.sh copies this to /etc/noureon-browser/host.env the first time; edit that copy, then run install.sh again.
# Nothing here is a secret. No address is written into the code: moving to another machine means a new copy of this file and install.sh.

# The public IPv4 address of THIS machine. install.sh asks the AWS metadata service for it; set it here when that does not work (another provider).
# It is also refused as a destination of the browsers, so a page cannot call back into this machine through its own public address.
PUBLIC_IP=

# The private network the browser containers live in. They have no way out except the egress proxy on the gateway address.
BROWSER_NET_NAME=noureon-browser
BROWSER_NET_BRIDGE=nbr0
BROWSER_NET_SUBNET=172.29.0.0/24
BROWSER_NET_GATEWAY=172.29.0.1

# The egress proxy (browser-host/egress-proxy.mjs): the only way out of the browser containers.
EGRESS_PORT=40001
EGRESS_ALLOW_PORTS=80,443
EGRESS_MAX_CONNECTIONS=400
# Where the browsers' traffic goes out. Choose ONE:
#  a) Cloudflare WARP in proxy mode on this machine (warp-proxy.sh sets it up):  EGRESS_UPSTREAM_SOCKS=127.0.0.1:40000
#  b) the SOCKS5 port of an existing container (the production machine has one called "warp", gost on 1080): set the two lines below, leave the one above empty.
#  c) both empty: go out directly from this machine's own address.
EGRESS_UPSTREAM_SOCKS=
EGRESS_UPSTREAM_CONTAINER=warp
EGRESS_UPSTREAM_PORT=1080
# More addresses or ranges to refuse, comma separated (the private ranges and PUBLIC_IP are always refused).
EGRESS_EXTRA_BLOCK=
# Names to refuse, comma separated; each name and every subdomain of it (public services of ours that no browser needs: the Supabase projects).
EGRESS_BLOCK_HOSTS=

# WebRTC media (the live screen) comes straight to this machine on this UDP range: open it in the security group.
UDP_PORT_MIN=52000
UDP_PORT_MAX=52100

# Capacity (see §11 of the design: 4 vCPU of AWS is about 2 physical cores, measure before trusting these).
BROWSER_MAX_SESSIONS=2
BROWSER_CPUS=1.8
BROWSER_MEMORY=2500m

# The live screen (leave BROWSER_LIVE_PUBLIC_IP empty to keep it off). Viewers open wss://BROWSER_LIVE_HOST/s/<random>/api/ws (the reverse proxy forwards to the small door below),
# and WebRTC goes straight to the public IP on one UDP+TCP port per browser (PORT_BASE .. PORT_BASE+SLOTS-1; open them in the firewall and at the provider).
BROWSER_LIVE_PUBLIC_IP=
BROWSER_LIVE_HOST=
BROWSER_LIVE_PORT_BASE=52000
BROWSER_LIVE_SLOTS=8
BROWSER_LIVE_MAX_VIEWERS=3
BROWSER_LIVE_PROXY_BIND=172.29.0.1
BROWSER_LIVE_PROXY_PORT=40011
# The pages that may hand a card straight to a browser (comma separated https origins; none: no card can be handed over).
BROWSER_LIVE_ALLOWED_ORIGINS=
# How the actions of a browser (a click, a look…) reach it: by default through one long-lived sidecar container for each browser (fast: no container is started for each action).
# `oneshot` goes back to a container for each action (about 2.4 s more for each action), if the long-lived one ever gives trouble.
BROWSER_SIDECAR_MODE=
