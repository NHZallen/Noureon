# Settings of one browser host. install.sh copies this to /etc/noureon-browser/host.env the first time; edit that copy, then run install.sh again.
# Nothing here is a secret. No address is written into the code: moving to another machine means a new copy of this file and install.sh.

# The public IPv4 address of THIS machine. install.sh asks the AWS metadata service for it; set it here when that does not work (another provider).
# It is also refused as a destination of the browsers, so a page cannot call back into this machine through its own public address.
PUBLIC_IP=

# The private network the browser containers live in. They have no way out except the egress proxy on the gateway address.
BROWSER_NET_NAME=noureon-browser
BROWSER_NET_BRIDGE=nbr0
BROWSER_NET_SUBNET=172.29.0.0/24
BROWSER_NET_GATEWAY=172.29.0.1

# The egress proxy (browser-host/egress-proxy.mjs): the only way out of the browser containers.
EGRESS_PORT=40001
EGRESS_ALLOW_PORTS=80,443
EGRESS_MAX_CONNECTIONS=400
# Cloudflare WARP in PROXY mode on this machine (warp-proxy.sh sets it up). Leave empty to go out directly.
EGRESS_UPSTREAM_SOCKS=127.0.0.1:40000
# More addresses or ranges to refuse, comma separated (the private ranges and PUBLIC_IP are always refused).
EGRESS_EXTRA_BLOCK=

# WebRTC media (the live screen) comes straight to this machine on this UDP range: open it in the security group.
UDP_PORT_MIN=52000
UDP_PORT_MAX=52100

# Capacity (see §11 of the design: 4 vCPU of AWS is about 2 physical cores, measure before trusting these).
BROWSER_MAX_SESSIONS=2
BROWSER_CPUS=1.8
BROWSER_MEMORY=2500m
