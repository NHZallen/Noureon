; The supervisord file for the Chromium of a browser container (replaces the one in neko's image; docker-args.mjs mounts the rendered copy read-only).
; Based on neko's own file (apps/chromium/supervisord.conf) with these changes for Noureon:
;   - NO --no-sandbox (Chromium's own sandbox is on: design §10.2 item 1, proven in §3.4);
;   - NO --bwsi: guest mode throws the cookies away when the browser closes, which would make a saved login impossible (design §8.1);
;   - NO --remote-allow-origins: our controller sends no Origin, and a page in the browser must not be able to talk to DevTools (design §10.2 item 12);
;   - --proxy-server: every request goes through the egress proxy, the only way out of the browser network (@@PROXY@@ is filled in by install.sh);
;   - a fixed language and time zone (some sites tie a login to them), --password-store=basic (no keyring in the container: cookies are encrypted with a fixed key,
;     so a saved login still opens on another machine), and the background activity switched off (round eight: it costs CPU and goes nowhere anyway).
[program:chromium]
; LANGUAGE: on Linux Chromium takes the language of its own pages from this variable (gettext style); --lang alone left them in English (seen on the real machine).
environment=HOME="/home/%(ENV_USER)s",USER="%(ENV_USER)s",DISPLAY="%(ENV_DISPLAY)s",TZ="Asia/Taipei",LANGUAGE="zh_TW:zh"
command=/usr/bin/chromium
  --proxy-server=@@PROXY@@
  --window-position=0,0
  --display=%(ENV_DISPLAY)s
  --user-data-dir=/home/neko/.config/chromium
  --no-first-run
  --start-maximized
  --lang=zh-TW
  --password-store=basic
  --force-dark-mode
  --disable-file-system
  --disable-gpu
  --disable-software-rasterizer
  --disable-dev-shm-usage
  --disable-background-networking
  --disable-component-update
  --disable-default-apps
  --no-pings
  --remote-debugging-port=9222
stopsignal=INT
autorestart=true
priority=800
user=%(ENV_USER)s
stdout_logfile=/var/log/neko/chromium.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
redirect_stderr=true

[program:openbox]
environment=HOME="/home/%(ENV_USER)s",USER="%(ENV_USER)s",DISPLAY="%(ENV_DISPLAY)s"
command=/usr/bin/openbox --config-file /etc/neko/openbox.xml
autorestart=true
priority=300
user=%(ENV_USER)s
stdout_logfile=/var/log/neko/openbox.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
redirect_stderr=true
