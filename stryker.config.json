{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/runtime-settings-api-keys.test.js tests/runtime-settings-api-key-controls.test.js tests/security/api-key-mask.test.js tests/security/sensitive-config-store.test.js tests/security/sensitive-config-redaction.test.js tests/runtime-sensitive-config-persistence.test.js tests/runtime-memory-profile-management.test.js tests/runtime-memory-suppression-management.test.js tests/runtime-memory-management-edge-cases.test.js tests/security/key-handling-edge-cases.test.js"
  },
  "mutate": [
    "src/app/runtime/security/api-key-input-intent.js",
    "src/app/runtime/security/sensitive-config-store.js",
    "src/app/runtime/security/sensitive-config-redaction.js",
    "src/app/runtime/memory/memory-profile-management.js",
    "src/app/runtime/memory/memory-suppression-management.js"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "ignorePatterns": ["dist", "docs", "public", "sandbox-host", "server", ".stryker-tmp", "reports", ".git", "supabase"],
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 85, "low": 70, "break": null }
}
