{
  "name": "noureon",
  "version": "17.15.4",
  "description": "A multi-provider AI workspace with reusable Nouras, model collaboration, image generation, and cloud sync.",
  "private": true,
  "license": "MIT",
  "homepage": "https://noureon.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NHZallen/Noureon.git"
  },
  "bugs": {
    "url": "https://github.com/NHZallen/Noureon/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node scripts/dev-server.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "vite build && node scripts/verify-production-katex.mjs && node scripts/build-public-pages.mjs",
    "check:legacy-runtime": "node scripts/check-legacy-runtime-boundaries.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:server": "node scripts/check-server-boundaries.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "chart.js": "^4.5.0",
    "cropperjs": "^1.6.2",
    "docx": "^9.7.2",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.13",
    "harfbuzzjs": "^1.6.2",
    "highlight.js": "^11.12.0",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "marked": "^15.0.12",
    "mathjax-full": "^3.2.2",
    "pdfjs-dist": "^6.3.289",
    "pdfmake": "^0.3.11",
    "peerjs": "^1.5.5",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.6",
    "pyodide": "314.0.7",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.16"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "speech-rule-engine": {
      "@xmldom/xmldom": "^0.9.12"
    }
  }
}
