# Noureon local development
# Most model provider API keys are entered in the app settings UI and stored locally.

# Optional. Used only by /api/google-form-submit for self-hosted feedback or proposal forms.
# Do not commit a real Google Apps Script URL.
GOOGLE_FORM_ENDPOINT=

# Optional local dev port. Vite defaults can also be used.
PORT=5173

# Cloudflare Turnstile. The site key is public; keep the secret server-side only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The address of the server (Coolify). Leave empty for the real site (https://api.noureon.com); the test site sets https://api-staging.noureon.com.
VITE_SERVER_API_URL=

# Supabase browser client configuration. Both values are safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google's own file picker for the sources of a project ("Add from Google Drive"). All three are public (they go to the browser); without them the choice is not shown.
# In the Google Cloud project: enable the Google Picker API and the Google Drive API; make an OAuth client of the type Web with the page's addresses as authorized JavaScript origins
# (https://noureon.com, https://staging.noureon.com); make an API key limited to the Picker API and those addresses. The scope is drive.file (the page can read only the files that are picked).
VITE_GOOGLE_PICKER_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
# The number of the Google Cloud project.
VITE_GOOGLE_PICKER_APP_ID=

# Server-only 32-byte base64 key used to encrypt sync-vault recovery data.
# Generate once and keep it stable. Rotating it requires re-encrypting existing recovery rows.
SYNC_VAULT_RECOVERY_KEY=
